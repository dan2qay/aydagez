# Скопируйте в .env и заполните. Ключ: https://developer.tech.yandex.ru → «JavaScript API и HTTP Геокодер»
YANDEX_MAPS_KEY=
# DATABASE_URL=postgres://aidaem:aidaem@localhost:5433/aidaem

# ИИ-поиск: любая модель с OpenAI-совместимым API. Без этих строк работают правила (словари).
# DeepSeek:            LLM_BASE_URL=https://api.deepseek.com/v1          LLM_MODEL_STRONG=deepseek-chat   LLM_MODEL_WEAK=deepseek-chat
# Qwen (DashScope):    LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL_STRONG=qwen-plus   LLM_MODEL_WEAK=qwen-turbo
# Ollama на сервере:   LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL_STRONG=qwen2.5:14b  LLM_MODEL_WEAK=qwen2.5:7b
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL_STRONG=
# LLM_MODEL_WEAK=
# LLM_TIMEOUT_MS=6000
# LLM_TRUST=gaps   # gaps: правила главнее, модель добирает пропуски (для 0.5–3B); lead: модель главнее (DeepSeek, qwen-plus)
# LLM_WAIT_MS=2500   # сколько ждать модель в запросе; дольше — отвечаем правилами, модель дорабатывает в фоне и попадает в кэш

# Публичный адрес сайта: ссылки в навыке Алисы, OAuth, sitemap (без слэша в конце)
PUBLIC_URL=
# Экран аналитики #/stats на проде (без токена открыт только с localhost)
ADMIN_TOKEN=
# Вход через Яндекс ID и Google (docs/growth.md)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
